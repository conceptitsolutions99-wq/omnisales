# Twilio Cloud Telephony Configuration for Real Live Calls
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PORT=3000

# Gmail SMTP sender (server-side only - never expose to the browser)
# 1. Enable 2-Step Verification on the Google account
# 2. Create an app password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password below (spaces are ignored)
GMAIL_USER=conceptitsolutions99@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional: display name shown to recipients
MAIL_FROM=Concept IT Solutions <conceptitsolutions99@gmail.com>
