# Twilio Cloud Telephony Configuration for Real Live Calls
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PORT=3000

# Staff accounts created in the Admin screen are stored here (Upstash Redis, free plan).
# Console -> your database -> Connect -> REST. Without these, accounts vanish on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sign-in is verified on the server. AUTH_SECRET signs the session cookie - use a long random string.
AUTH_SECRET=replace_with_a_long_random_string

# The permanent admin account. Staff accounts are created from the Admin screen.
ADMIN_EMAIL=you@company.com
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_NAME=Administrator

# Optional browser key for the lead-search fallback (free plan, no card)
# https://myprojects.geoapify.com - restrict the key to your domain before shipping it
VITE_GEOAPIFY_API_KEY=your_geoapify_key_here

# Gmail SMTP sender (server-side only - never expose to the browser)
# 1. Enable 2-Step Verification on the Google account
# 2. Create an app password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password below (spaces are ignored)
GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional: display name shown to recipients
MAIL_FROM=Concept IT Solutions <your.address@gmail.com>
