# Copy to .env and fill in. Never commit the real file.

# Signs the session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# The permanent administrator, used to sign in before any staff accounts exist
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Staff accounts, sent-message attribution and reply assignments live in Postgres.
# Supabase: Project Settings -> Database -> Connection string (use the pooler host, port 5432).
DATABASE_URL=

# SMTP for outreach, and IMAP for reply tracking (Google app password, not the account password).
# Deliverability: the From address must belong to the mailbox that authenticates. On Gmail that
# is GMAIL_USER, whatever MAIL_FROM says, because Gmail rewrites any other sender. To send as a
# company address, point SMTP_HOST at a provider that has your domain verified (SPF, DKIM and
# DMARC published in DNS) and set MAIL_FROM to that address.
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
# Relay credentials (used instead of the Gmail pair when SMTP_HOST is a provider)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# On Gmail the From is the authenticated account unless the MAIL_FROM address is a
# verified "send mail as" alias in that Gmail account; set this to true only then.
GMAIL_FROM_ALIAS_VERIFIED=

# Reputation guard for the shared mailbox: outreach messages per UTC calendar day, and the
# minimum gap between two sends. Both apply to the whole team, not per agent.
OUTREACH_DAILY_LIMIT=60
OUTREACH_MIN_GAP_SECONDS=30

# Warm-up guard: set OUTREACH_WARMUP_START to the date the mailbox starts sending (YYYY-MM-DD).
# The daily ceiling begins at OUTREACH_WARMUP_START_LIMIT and grows by OUTREACH_WARMUP_DAILY_STEP
# each day until it reaches OUTREACH_DAILY_LIMIT. Leave it empty once the mailbox is warm.
OUTREACH_WARMUP_START=
OUTREACH_WARMUP_START_LIMIT=10
OUTREACH_WARMUP_DAILY_STEP=5

# How long another agent's contact to the same prospect (email, company domain or phone) blocks
# a duplicate send. The compose card names who wrote first and offers an explicit override.
LEAD_CONTACT_WINDOW_HOURS=24

# Shown in the footer every outreach email carries, with the opt-out line.
# No postal address is sent: it is intentionally absent from outreach messages.
COMPANY_NAME=Concept IT Solutions
# Opt-out links are generated per recipient and served from this app, so no unsubscribe URL
# needs configuring. APP_ORIGIN is only needed when links must use a domain other than the
# one the app is served from; unsubscribe links are signed with AUTH_SECRET (or
# UNSUBSCRIBE_SECRET when set) and are honoured without signing in.
APP_ORIGIN=
UNSUBSCRIBE_SECRET=

# Lead search fallback (map tiles). Optional.
VITE_GEOAPIFY_API_KEY=

# The dialler calls through the agent's own phone or WhatsApp, so no telephony account is needed

PORT=3000
