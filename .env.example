# Copy to .env and fill in. Never commit the real file.

# Signs the session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# The permanent administrator, used to sign in before any staff accounts exist
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Staff accounts, sent-message attribution and reply assignments live in Postgres.
# Supabase: Project Settings -> Database -> Connection string (use the pooler host, port 5432).
DATABASE_URL=

# Gmail SMTP for outreach, and IMAP for reply tracking (Google app password, not the account password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=

# Lead search fallback (map tiles). Optional.
VITE_GEOAPIFY_API_KEY=

# Twilio dialler (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TWIML_APP_SID=

PORT=3000
